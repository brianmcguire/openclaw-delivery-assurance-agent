{
  "id": "delivery-assurance-agent",
  "name": "Delivery Lens",
  "description": "Your startup's delivery lead. Example: when sandbox access blocks a pilot, collect the owner's update, request a recovery plan, and bring the approval decision to the founder.",
  "categories": [
    "productivity"
  ],
  "contracts": {
    "tools": [
      "delivery_record",
      "delivery_update",
      "delivery_brief",
      "delivery_checkin",
      "delivery_setup_card",
      "delivery_participant_card"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dataDir": {
        "type": "string"
      },
      "agentId": {
        "type": "string",
        "default": "delivery-assurance-agent"
      },
      "allowUnverifiedLocal": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "dataDir"
    ]
  }
}
