# This file documents variables. Do not commit .env or credentials.
# Setup reads DELIVERY_MODEL. Choose your configured provider/model.
DELIVERY_MODEL=provider/model
# Optional isolated gateway port, set before initial installation.
# DELIVERY_PORT=19789
# Optional collector overrides. DELIVERY_DATA_DIR must match the plugin dataDir
# configured in the isolated OpenClaw profile; it does not move the agent store.
# DELIVERY_DATA_DIR=/absolute/private/path/delivery-data
# DELIVERY_INDEX_STATE_DIR=/absolute/private/path/agent-index
# Only needed during official Agent Index registration. Obtain through Plow.
# PLOW_AGENT_TOKEN=
